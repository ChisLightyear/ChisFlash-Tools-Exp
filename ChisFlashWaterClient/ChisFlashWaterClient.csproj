<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.30</Version>
    <AssemblyVersion>2.0.30.0</AssemblyVersion>
    <FileVersion>2.0.30.0</FileVersion>
    <InformationalVersion>2.030 MIX</InformationalVersion>
    <AssemblyName>ChisFlashWaterClient</AssemblyName>
    <RootNamespace>ChisFlashWaterClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_build_*/**/*.cs" />
    <Compile Remove="_verify_*/**/*.cs" />
    <Compile Remove="_codex_build_*/**/*.cs" />
    <Compile Remove="_codex_probe_*/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <EmbeddedResource Remove="_build_*/**" />
    <EmbeddedResource Remove="_verify_*/**" />
    <EmbeddedResource Remove="_codex_build_*/**" />
    <EmbeddedResource Remove="_codex_probe_*/**" />
    <None Remove="_build_*/**" />
    <None Remove="_verify_*/**" />
    <None Remove="_codex_build_*/**" />
    <None Remove="_codex_probe_*/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.4" />
    <PackageReference Include="System.Management" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GbaMultiMenuBuilder\Models\AppSettings.cs" Link="BuilderImported\Models\AppSettings.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\BuildGameEntry.cs" Link="BuilderImported\Models\BuildGameEntry.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\BuildLayoutEstimate.cs" Link="BuilderImported\Models\BuildLayoutEstimate.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\BuildProgressInfo.cs" Link="BuilderImported\Models\BuildProgressInfo.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\BuildRequest.cs" Link="BuilderImported\Models\BuildRequest.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\BuildResult.cs" Link="BuilderImported\Models\BuildResult.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\ConfigPreviewReport.cs" Link="BuilderImported\Models\ConfigPreviewReport.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\DetectedSaveTypeInfo.cs" Link="BuilderImported\Models\DetectedSaveTypeInfo.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\DetectedSaveTypeKind.cs" Link="BuilderImported\Models\DetectedSaveTypeKind.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\FlashCartMode.cs" Link="BuilderImported\Models\FlashCartMode.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\GbaMenuType.cs" Link="BuilderImported\Models\GbaMenuType.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Models\MenuPreviewModel.cs" Link="BuilderImported\Models\MenuPreviewModel.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\AppConfigService.cs" Link="BuilderImported\Services\AppConfigService.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\CompilationBuilder.cs" Link="BuilderImported\Services\CompilationBuilder.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\RomArchiveImportService.cs" Link="BuilderImported\Services\RomArchiveImportService.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\Chm1Layout.cs" Link="BuilderImported\Services\Chm1Layout.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GameBoyRomHeaderService.cs" Link="BuilderImported\Services\GameBoyRomHeaderService.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GbaCoverCatalog.cs" Link="BuilderImported\Services\GbaCoverCatalog.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GbaMenuCoverPackBuilder.cs" Link="BuilderImported\Services\GbaMenuCoverPackBuilder.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GbcBackgroundImageEncoder.cs" Link="BuilderImported\Services\GbcBackgroundImageEncoder.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GbcFontService.cs" Link="BuilderImported\Services\GbcFontService.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\GbcMenuLayerBuilder.cs" Link="BuilderImported\Services\GbcMenuLayerBuilder.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\IniDocument.cs" Link="BuilderImported\Services\IniDocument.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\LanguageService.cs" Link="BuilderImported\Services\LanguageService.cs" />
    <Compile Include="..\GbaMultiMenuBuilder\Services\UiLanguage.cs" Link="BuilderImported\Services\UiLanguage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="covers\cover_index.csv;covers\cover_overrides.csv"
             Condition="'$(ExcludeCoverCatalog)' != 'true' And Exists('covers')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="covers\original\*.png"
             Condition="'$(ExcludeCoverCatalog)' != 'true' And Exists('covers\original')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 菜单 ROM：优先取同级 rom_builder 的最新产物；仓库独立分发时回落到自带的 Assets\ 副本 -->
    <Content Include="..\GBA_MultiMenu_extended-main\rom_builder\lk_multimenu.gba"
             Link="Assets\lk_multimenu.gba"
             Condition="Exists('..\GBA_MultiMenu_extended-main\rom_builder\lk_multimenu.gba')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GBA_MultiMenu_extended_WL\rom_builder\lk_multimenu_wl.gba"
             Link="Assets\wl_magic_menu.gba"
             Condition="Exists('..\GBA_MultiMenu_extended_WL\rom_builder\lk_multimenu_wl.gba')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GBA_MultiMenu_extended_NEW\GBA_MultiMenu_extended_NEW.gba"
             Link="Assets\universal_menu.gba"
             Condition="Exists('..\GBA_MultiMenu_extended_NEW\GBA_MultiMenu_extended_NEW.gba')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GBA_MultiMenu_Simplified_NS\GBA_MultiMenu_Simplified_NS.gba"
             Link="Assets\simplified_ns_menu.gba"
             Condition="Exists('..\GBA_MultiMenu_Simplified_NS\GBA_MultiMenu_Simplified_NS.gba')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\lk_multimenu.gba;Assets\wl_magic_menu.gba;Assets\universal_menu.gba;Assets\simplified_ns_menu.gba"
             Condition="!Exists('..\GBA_MultiMenu_extended-main\rom_builder\lk_multimenu.gba')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\batteryless_payload.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\batteryless_payload_flash4_compat.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\menu_zh.gb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\menu_en.gb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GbaMultiMenuBuilder\Assets\Fonts\**\*"
             Link="Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="save_types.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Languages\*.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GbaMultiMenuBuilder\Fc\*.cs" Link="Fc\%(Filename)%(Extension)" />
    <Compile Include="..\GbaMultiMenuBuilder\Md\*.cs" Link="Md\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\GbaMultiMenuBuilder\Fc\MesenNesDB.csv" LogicalName="ChisFlash.Fc.MesenNesDB" />
  </ItemGroup>
</Project>
